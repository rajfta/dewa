# Site URL for SEO (hreflang tags)
NEXT_PUBLIC_SITE_URL=https://dewa.hu

# Google Analytics 4 measurement ID.
# Optional - defaults to the live DEWA property (G-QYN7MMFWHY) in production
# builds. Set this only to point a deployment at a different GA4 property.
NEXT_PUBLIC_GA_ID=G-QYN7MMFWHY

# TinaCMS
TINACMS_PUBLIC_CLIENT_ID=
TINACMS_TOKEN=

# GitHub (if using)
GITHUB_CLIENT_ID=
REPO_FULL_NAME=
BASE_BRANCH=

# Email API (Nodemailer)
# Add your email configuration here
